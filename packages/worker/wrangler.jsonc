// The Worker serves the built web app (static assets) and the model API. `vite dev` and `vite preview` in
// packages/web run it in workerd, the runtime Cloudflare uses, through the Cloudflare Vite plugin; `vite build` there
// emits the deployable Worker. Local D1 data lives in .wrangler/state (delete it, or run `npm run db:reset`, to reset).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "app",
  "main": "./src/index.ts",
  "compatibility_date": "2026-10-01",
  // Deployed at app.feature-domain.workers.dev (infrastructure/ puts Cloudflare Access in front of it). Preview URLs
  // (a hostname per uploaded version) are off: Access covers only the main hostname.
  "workers_dev": true,
  "preview_urls": false,
  // Published apps, at <slug>.apprun.app: infrastructure/ makes the wildcard DNS record and puts Access in front.
  "routes": [{ "pattern": "*.apprun.app/*", "zone_name": "apprun.app" }],
  "vars": {
    // Which site a request is for (src/hosts.ts): the builder's host, or an app under this domain. Anything else gets a
    // 404. packages/worker/.dev.vars sets both to localhost in development.
    "BUILDER_HOST": "app.feature-domain.workers.dev",
    "APP_DOMAIN": "apprun.app",
  },
  "assets": {
    // The Worker answers every request first, so an app's host never gets the editor: it passes the builder's
    // non-API requests to the assets (env.ASSETS), and serves app.html on an app's.
    "binding": "ASSETS",
    "run_worker_first": true,
    // Editor routes (/models/:id) are client-side, so unknown paths get index.html.
    "not_found_handling": "single-page-application",
    // Files are served at their own paths: the editor links to /preview.html?model=…, as `vite dev` serves it, so no
    // redirect to /preview.
    "html_handling": "none",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "feature-domain",
      // The database Terraform created (`terraform output d1_database_id` in infrastructure/). Local development and
      // tests use a local copy named after this id, so changing it starts local data afresh.
      "database_id": "9de3d514-43a1-40e8-a04a-ed6035020242",
      "migrations_dir": "./migrations",
    },
  ],
}
