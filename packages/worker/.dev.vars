# Development (`vite dev`, `vite preview`, the tests' local D1): the builder at localhost, and published apps at
# <slug>.localhost (browsers resolve every *.localhost to this machine). Deployed, wrangler.jsonc's vars apply: wrangler
# never uploads this file.
BUILDER_HOST=localhost
APP_DOMAIN=localhost
# For development only: deployed, AUTH_SECRET is a Worker secret (infrastructure/README.md), never this.
AUTH_SECRET=development-only-auth-secret-not-for-deploying-0123456789
