{
  "name": "@feature-domain/worker",
  "version": "0.1.0",
  "private": true,
  "license": "FSL-1.1-ALv2",
  "description": "Cloudflare Worker: serves the web app and the model API, stored in D1",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx --conditions=@feature-domain/source scripts/seed.ts",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "db:reset": "rm -rf .wrangler/state && npm run db:setup"
  },
  "dependencies": {
    "@feature-domain/engine": "0.1.0",
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261016.1",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "wrangler": "4.151.0"
  }
}
